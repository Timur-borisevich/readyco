{
  "version": 2,
  "functions": {
    "api/server.py": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/server.py" },
    { "src": "/inbox", "dest": "api/server.py" },
    { "src": "/admin", "dest": "api/server.py" },
    { "src": "/(site.html|admin.html|logo.png|brandbook/.*|figma_kit/.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "api/server.py" }
  ]
}