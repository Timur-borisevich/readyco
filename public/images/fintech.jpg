<!DOCTYPE html>
<html lang="en">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta charset="UTF-8">
        <title>Bot check</title>
        <!-- https://github.com/brix/crypto-js ; crypto module only available in secure context -->
        <script type="text/javascript" src="data:text/javascript;base64,"></script>
        <style>
            html {
                height: 100%;
                width: 100%;
            }

            body {
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
                height: 100%;
            }

            main {
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
            }

            #textbox {
                margin-top: 30px;
                text-align: center;
            }

            #loaderbox {
                width: 75px;
                height: 75px;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            #loader {
                width: 50px;
                padding: 8px;
                aspect-ratio: 1;
                border-radius: 50%;
                background: #D5102D;
                --_m:
                    conic-gradient(#0000 10%,#000),
                    linear-gradient(#000 0 0) content-box;
                -webkit-mask: var(--_m);
                        mask: var(--_m);
                -webkit-mask-composite: source-out;
                        mask-composite: subtract;
                animation: l3 1s infinite linear;
            }

            @keyframes l3 {to{transform: rotate(1turn)}}

            #erroricon {
                width: 100%;
                height: 100%;
                display: none;
            }

            #successicon {
                width: 100%;
                height: 100%;
                display: none;
            }

        </style>
    </head>
    <body>

        <main>
            <div id="loaderbox">
                <div id="loader"></div>
                <svg version="1.1" id="erroricon" viewBox="0 0 50 50">
                    <circle style="fill:#D5102D;" cx="25" cy="25" r="25"/>
                    <polyline style="fill:none;stroke:#FFFFFF;stroke-width:2;stroke-linecap:round;stroke-miterlimit:10;" points="16,34 25,25 34,16"/>
                    <polyline style="fill:none;stroke:#FFFFFF;stroke-width:2;stroke-linecap:round;stroke-miterlimit:10;" points="16,16 25,25 34,34 "/>
                </svg>
                <svg version="1.1" id="successicon" viewBox="0 0 50 50" xml:space="preserve">
                    <circle style="fill:#25AE88;" cx="25" cy="25" r="25"/>
                    <polyline style="fill:none;stroke:#FFFFFF;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;stroke-miterlimit:10;" points="38,15 22,33 12,25 "/>
                </svg>
            </div>
            <span id="textbox"></span>
        </main>

        <noscript>Javascript is needed to access this site</noscript>

        <script>
            const textbox = document.getElementById("textbox");
            const errorIcon = document.getElementById("erroricon");
            const successIcon = document.getElementById("successicon");
            const loader = document.getElementById("loader");

            const userLang = navigator.language || navigator.userLanguage;
            const langCode = userLang.substring(0, 2);

            const messages = {
                "loading": {
                    "de": "Ihre Anfrage wird überprüft. Bitte haben Sie einen Moment Geduld.",
                    "default": "Your request is being verified. Please wait a moment."
                },
                "error": {
                    "de": "Die Überprüfung konnte nicht abgeschlossen werden. Bitte laden Sie diese Seite erneut.",
                    "default": "Verification could not be completed. Please reload this page."
                },
                "success": {
                    "de": "Die Überprüfung war erfolgreich. Sie gelangen nun zur angeforderten Seite.",
                    "default": "Verification successful. You will now be taken to the requested page."
                }
            };

            function showError(message = "error") {
                textbox.innerText = messages[message][langCode] || messages[message]["default"];
                errorIcon.style.display = "inline";
                successIcon.style.display = "none";
                loader.style.display = "none";
            }

            function showLoading() {
                textbox.innerText = messages["loading"][langCode] || messages["loading"]["default"];
                errorIcon.style.display = "none";
                successIcon.style.display = "none";
                loader.style.display = "flex";
            }

            function showSuccess() {
                textbox.innerText = messages["success"][langCode] || messages["success"]["default"];
                errorIcon.style.display = "none";
                successIcon.style.display = "flex";
                loader.style.display = "none";
            }

            window.addEventListener("load", async () => {
                await pow();
            });

            async function pow() {
                showLoading();

                const challenge = await getChallenge();
                if (challenge === null) {
                    showError();
                    return;
                }

                const res = await solveChallenge(challenge);
                if (res === null) {
                    showError();
                    return;
                }

                const success = await sendResult(res);
                if (!success) {
                    showError();
                    return;
                }

                showSuccess();

                setTimeout(() => {
                    window.location.reload();
                }, 500);
            }

            async function getChallenge() {
                try {
                    const response = await fetch("?create_challenge");
                    if (!response.ok) {
                        return null;
                    }
                    return await response.json()
                } catch (error) {
                    console.error(error.message);
                    return null;
                }
            }

            async function solveChallenge(challenge) {
                const salt = challenge['salt'];
                const verify = challenge['verify'];
                const expire = challenge['expire'];
                const algo = challenge['algo'];
                const max_number = challenge['max_number'] ?? 0;
                const challenge_hash = challenge['challenge'];

                const hash_functions = {
                    "sha256": CryptoJS.SHA256,
                    "sha384": CryptoJS.SHA384,
                    "sha512": CryptoJS.SHA512,
                }

                const hash_function = hash_functions[algo];

                if (!hash_function) {
                    return null;
                }

                let number = null;

                for (let i=1; i<=max_number; i++) {
                    const hash_value = `${i}${salt}${expire}`;
                    const hash = hash_function(hash_value).toString();

                    if (hash === challenge_hash) {
                        number = i;
                        break;
                    }
                }

                if (number === null) {
                    return null;
                }

                return {
                    "number": number,
                    "verify": verify,
                    "salt": salt,
                    "expire": expire,
                    "algo": algo
                }

            }

            async function sendResult(result) {
                const response = await fetch("?verify_challenge", {
                    method: "POST",
                    body: JSON.stringify(result),
                    headers: {
                        "Content-Type": "application/json"
                    }
                })

                return response.ok;
            }
        </script>

    </body>
</html>